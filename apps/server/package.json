{
  "name": "outpost-app-server",
  "version": "1.0.4",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nova utility run-scripts --parallel --node-env development \"dev:*\"",
    "dev:start": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:web": "vite",
    "prod": "nova utility run-scripts --sequential --node-env production \"prod:*\"",
    "prod:start": "node --env-file-if-exists=.env build/index.js",
    "check": "nova utility run-scripts --sequential \"check:*\"",
    "check:lint": "eslint ./ --max-warnings=0",
    "check:types-source": "nova utility type-check --project tsconfig.source.json",
    "check:types-config": "nova utility type-check --project tsconfig.config.json",
    "check:types-tests": "nova utility type-check --project tsconfig.tests.json",
    "check:types-web": "nova utility type-check --project tsconfig.web.json",
    "check:test": "vitest run",
    "build": "nova utility run-scripts --sequential --node-env production \"build:*\"",
    "build:reset": "shx rm -rf ./build",
    "build:transpile": "nova utility transpile --project tsconfig.source.json",
    "build:web": "vite build",
    "clean": "nova utility run-scripts --parallel \"clean:*\"",
    "clean:build": "shx rm -rf ./build",
    "mock": "vite --mode mock"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@cbnventures/nova": "0.38.0",
    "@simplewebauthn/server": "14.0.3",
    "croner": "9.1.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "nodemailer": "10.2.1",
    "outpost-package-docker-engine": "file:../../packages/docker-engine",
    "outpost-package-registry": "file:../../packages/registry",
    "outpost-package-updater": "file:../../packages/updater",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/node": "24.9.1",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "notyf": "3.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shx": "0.4.0",
    "tsx": "4.19.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
