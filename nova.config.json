{
  "project": {
    "name": {
      "title": "Outpost",
      "slug": "outpost"
    },
    "description": {
      "short": "Self-hosted container auto-updater for Docker, a modern Watchtower replacement",
      "long": "Keeps your Docker containers on the latest image: checks registries on a schedule, pulls new images, and recreates containers with their original settings, volumes, and networks, rolling back automatically when the new container fails to start. Label-based opt-in or opt-out, monitor-only mode, ntfy and webhook notifications, an HTTP API, and Prometheus metrics, shipped as one non-root s6-overlay image."
    },
    "keywords": [
      "docker",
      "watchtower",
      "container",
      "auto-update",
      "self-hosted",
      "homelab",
      "devops"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "docker",
      "web"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "CBN Ventures",
      "email": "contact@cbnventures.io",
      "url": "https://www.cbnventures.io/",
      "roles": [
        "author"
      ]
    },
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "contributor",
        "supporter"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@cbnventures.io"
  },
  "github": {
    "owner": "cbnventures",
    "repo": "outpost",
    "topics": [
      "docker",
      "watchtower",
      "watchtower-alternative",
      "container",
      "auto-update",
      "self-hosted",
      "homelab",
      "typescript"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "nodejs"
      ]
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 45,
      "build": [
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "docker-hub",
          "path": "./",
          "with": {
            "IMAGE_NAMESPACE": "cbnventures",
            "IMAGE_REPOSITORY": "outpost"
          }
        },
        {
          "to": "ghcr",
          "path": "./",
          "with": {
            "IMAGE_REPOSITORY": "outpost"
          }
        },
        {
          "to": "cloudflare-pages-docusaurus",
          "path": "./apps/docs"
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://outpost.cbnventures.io/",
    "repository": "git+https://github.com/cbnventures/outpost.git",
    "bugs": "https://github.com/cbnventures/outpost/issues",
