  "dockerHub": {
    "namespace": "cbnventures",
    "repository": "outpost",
    "visibility": "public",
    "categories": [
      "integration-and-delivery",
      "monitoring-and-observability"
    ]
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-24.04",
      "timeoutMinutes": 90,
      "build": [
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "docker-hub",
          "path": "./"
        },
        {
          "to": "ghcr",
          "path": "./",
          "with": {
            "IMAGE_REPOSITORY": "outpost"
          }
        },
        {
          "to": "cloudflare-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        }
      ]
    }
  ],
