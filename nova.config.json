{
  "project": {
    "name": {
      "title": "Outpost",
      "slug": "outpost"
    },
    "description": {
      "short": "A modern Watchtower replacement that updates Docker containers and rolls back failed starts",
      "long": "Pull image updates on your schedule and bring each container back with its original settings, volumes, and networks. Pick containers by label or watch in monitor-only mode, follow it all from a web dashboard, and get notified through ntfy, Telegram, Discord, email, and more."
    },
    "keywords": [
      "docker",
      "watchtower",
      "container",
      "auto-update",
      "self-hosted",
      "homelab",
      "devops"
    ],
    "legalName": "CBN Ventures LLC",
    "pronouns": "business",
    "platforms": [
      "nodejs",
      "docker",
      "web"
    ],
    "startingYear": 2026,
    "license": "MIT"
  },
