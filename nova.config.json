  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_"
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./apps/server": {
        "prefix": "SERVER_"
      },
      "./packages/docker": {
        "prefix": "DOCKER_"
      },
      "./packages/docker-engine": {
        "prefix": "ENGINE_"
      },
      "./packages/registry": {
        "prefix": "REGISTRY_"
      },
      "./packages/updater": {
        "prefix": "UPDATER_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
