#!/bin/sh
set -eu
if [ -x /etc/nova-docker/healthcheck ]; then
  exec /etc/nova-docker/healthcheck
fi
/command/s6-svstat -u /run/service/server >/dev/null
node -e "fetch('http://127.0.0.1:' + (process.env.PORT ?? '22601') + '/health').then((response) => process.exit(response.ok ? 0 : 1), () => process.exit(1))"
exit 0
