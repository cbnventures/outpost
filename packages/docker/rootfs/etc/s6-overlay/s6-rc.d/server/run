#!/command/with-contenv sh
set -eu
if [ -f /app/.pnp.cjs ]; then
  export NODE_OPTIONS="--require=/app/.pnp.cjs${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
fi
if [ -f /app/.pnp.loader.mjs ]; then
  export NODE_OPTIONS="--experimental-loader=/app/.pnp.loader.mjs${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
fi
cd '/app/apps/server'

# Outpost runs as PUID/PGID; add the Docker socket's group so it can reach the daemon.
docker_socket="${DOCKER_HOST:-unix:///var/run/docker.sock}"
docker_socket="${docker_socket#unix://}"
supplementary_groups="${PGID:-1000}"
if [ -S "${docker_socket}" ]; then
  socket_group="$(stat -c '%g' "${docker_socket}")"
  supplementary_groups="${supplementary_groups},${socket_group}"
fi

exec /command/s6-applyuidgid -u "${PUID:-1000}" -g "${PGID:-1000}" -G "${supplementary_groups}" node build/index.js
