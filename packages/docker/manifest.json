{
  "schemaVersion": 1,
  "services": [
    {
      "command": "node build/index.js",
      "critical": false,
      "dependencies": [],
      "environment": {},
      "kind": "longrun",
      "name": "server",
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/server",
      "writablePaths": [
        "/data"
      ],
      "healthCommand": "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT ?? '22601') + '/health').then((response) => process.exit(response.ok ? 0 : 1), () => process.exit(1))\"",
      "port": 22601
    }
  ],
  "workspaces": [
    {
      "packageName": "outpost-app-server",
      "path": "apps/server",
      "profile": "http-service",
      "runtimePaths": []
    }
  ]
}
