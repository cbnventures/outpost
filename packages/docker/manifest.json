{
  "healthPath": "/health",
  "legacyStatePaths": [
    "account.json",
    "database/outpost.sqlite3",
    "database/outpost.sqlite3-shm",
    "database/outpost.sqlite3-wal",
    "history.json",
    "image-config-cache.json",
    "keys/installation.key",
    "outpost.sqlite3",
    "outpost.sqlite3-shm",
    "outpost.sqlite3-wal",
    "self-update.json"
  ],
  "networkMode": "host",
  "schemaVersion": 1,
  "services": [
    {
      "command": "bash docker/start-server.sh",
      "critical": true,
      "dependencies": [],
      "environment": {},
      "kind": "longrun",
      "name": "server",
      "requiredForHealth": true,
      "runAsRoot": true,
      "workspace": "apps/server",
      "writablePaths": [],
      "port": 22601
    }
  ],
  "stateEnvironment": "OUTPOST_DATA_DIRECTORY",
  "workspaces": [
    {
      "packageName": "outpost-app-server",
      "path": "apps/server",
      "profile": "http-service",
      "runtimePaths": []
    }
  ]
}
