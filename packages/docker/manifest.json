{
  "build": {
    "copyNovaConfig": false,
    "corepack": true
  },
  "compose": {
    "comment": [
      "Dashboard at http://localhost:22601/admin/. On the first visit, create the",
      "account with the setup code from \"docker compose logs outpost\". Access",
      "tokens for POST /v1/update, GET /v1/status, and GET /metrics are made",
      "on the dashboard's Access tokens page.",
      "Outpost follows the same labels for its own container, so it updates",
      "itself too, last in each check. Uncomment to keep it on its current image.",
      "labels:",
      "  io.cbnventures.outpost.enable: \"false\""
    ],
    "image": "\"${OUTPOST_IMAGE:-cbnventures/outpost:latest}\"",
    "service": "outpost",
    "volumes": [
      {
        "source": "/var/run/docker.sock",
        "target": "/var/run/docker.sock"
      },
      {
        "comment": [
          "Dashboard account, access tokens, notification destinations, registry",
          "sign-ins, and update history. Keep /config on a volume: Outpost needs it to",
          "update itself."
        ],
        "source": "outpost-data",
        "target": "/config"
      }
    ]
  },
  "healthPath": "/health",
  "images": {
    "debian": {
      "reference": "debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
    },
    "node": {
      "reference": "node:24.22.0-trixie-slim@sha256:a6155384446670e9719bdc4fd0ebe4d4b29fb32a8d6aa523da3547a6cfbcf22c"
    }
  },
  "legacyStatePaths": [
    "account.json",
    "database/outpost.sqlite3",
    "database/outpost.sqlite3-shm",
    "database/outpost.sqlite3-wal",
    "history.json",
    "image-config-cache.json",
    "keys/installation.key",
    "outpost.sqlite3",
    "outpost.sqlite3-shm",
    "outpost.sqlite3-wal",
    "self-update.json"
  ],
  "networkMode": "host",
  "schemaVersion": 2,
  "services": [
    {
      "command": "bash docker/start-server.sh",
      "critical": true,
      "dependencies": [],
      "environment": {},
      "kind": "longrun",
      "name": "server",
      "port": 22601,
      "requiredForHealth": true,
      "runAsRoot": true,
      "workspace": "apps/server",
      "writablePaths": []
    }
  ],
  "stateEnvironment": "OUTPOST_DATA_DIRECTORY",
  "workspaces": [
    {
      "packageName": "outpost-app-server",
      "path": "apps/server",
      "profile": "http-service",
      "runtimePaths": []
    }
  ]
}
